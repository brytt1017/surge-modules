#!name=美股時段面板
#!desc=Surge 首頁顯示美股目前時段（盤前／盤中／盤後／休市）、下一個轉換點倒數，含 NYSE 休市日與提早收盤日。純本地計算、免 API、免 MitM。預設 5 分鐘更新。
#!category=Mingliang Lab
#!author=Brytt

[Panel]
us-market-panel = script-name=us-market-panel,update-interval=300

[Script]
us-market-panel = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/brytt1017/surge-modules/main/scripts/us-market-panel.js
