[Panel]
fear-greed-panel = script-name=fear-greed-panel,update-interval=3600

[Script]
fear-greed-panel = type=generic,timeout=10,script-path=https://raw.githubusercontent.com/brytt1017/surge-modules/main/scripts/fear-greed-panel.js
